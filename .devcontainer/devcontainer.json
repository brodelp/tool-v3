{
  "name": "SCAT validator (tool-v3)",
  "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
  "service": "api",
  "workspaceFolder": "/app",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "git config --global --add safe.directory /app && uv sync --locked && make db-wait && make migrate",
  "forwardPorts": [8000, "db:5432"],
  "portsAttributes": {
    "8000": { "label": "SCAT API", "onAutoForward": "notify" },
    "db:5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "ruff.importStrategy": "fromEnvironment",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        },
        "terminal.integrated.detectLocale": "off",
        "files.eol": "\n",
        "files.insertFinalNewline": true
      }
    }
  }
}
