# Copy to .env (git-ignored) to override the dev-only database defaults in compose.yaml.
# Compose reads .env from the project root for both `docker compose up` and the dev container.
# Changing these after the first start has no effect on an existing volume; see README.md.
POSTGRES_DB=scat
POSTGRES_USER=scat
POSTGRES_PASSWORD=scat

# Optional LLM annotation (stage 4). Leave unset to disable it. Never commit a real key.
# With a cloud provider, case narratives are sent to that provider (see README.md, LLM annotation).
#
# Anthropic:
# SCAT_LLM_PROVIDER=anthropic
# SCAT_LLM_MODEL=claude-opus-5-5
# SCAT_LLM_API_KEY=<your key>
#
# Anthropic-compatible gateway that takes a Bearer token (the SDK's auth_token):
# SCAT_LLM_PROVIDER=anthropic
# SCAT_LLM_MODEL=<gateway model id>
# SCAT_LLM_API_KEY=<access-key>:<secret-key>
# SCAT_LLM_BASE_URL=https://<gateway host>/<path>/anthropic
# SCAT_LLM_AUTH=bearer
#
# Ollama on the host (OpenAI-compatible, no key):
# SCAT_LLM_PROVIDER=openai
# SCAT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# SCAT_LLM_MODEL=llama3.1:8b
#
# Optional: SCAT_LLM_TIMEOUT_SECONDS=600, SCAT_LLM_MAX_OUTPUT_TOKENS=32000
